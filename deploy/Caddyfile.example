{
    admin off
    auto_https disable_redirects
}

# Replace api.example.com with the confirmed hostname. 443 remains owned by Xray.
https://api.example.com:8443 {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    @api path /api/v1/*
    handle @api {
        reverse_proxy 127.0.0.1:8787
    }
    handle {
        respond "Not Found" 404
    }
}
