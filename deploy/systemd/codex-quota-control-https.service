[Unit]
Description=HTTPS entry for Codex quota management on 8443
After=network-online.target codex-quota-control-api.service
Wants=network-online.target

[Service]
Type=notify
User=codexquota-proxy
Group=codexquota-proxy
WorkingDirectory=/var/lib/codex-quota-control/https
Environment=XDG_DATA_HOME=/var/lib/codex-quota-control/https/data
Environment=XDG_CONFIG_HOME=/var/lib/codex-quota-control/https/config
ExecStart=/usr/local/lib/codex-quota-control/caddy run --config /etc/codex-quota-proxy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/codex-quota-control/https

[Install]
WantedBy=multi-user.target
